{% extends "layout.njk" %}

{% block content %}

<div style="display:flex; flex-direction:column; height:calc(100vh - 2rem); background:var(--dark-2); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow);">

  {# Header #}
  <div style="flex-shrink:0; display:flex; justify-content:space-between; align-items:center; padding:0.85rem 1.25rem; border-bottom:1px solid var(--border); background:var(--dark-3);">
    <div style="display:flex; align-items:center; gap:0.75rem;">
      <div style="width:28px; height:28px; background:linear-gradient(135deg,var(--purple-600),var(--purple-400)); border-radius:7px; display:flex; align-items:center; justify-content:center; font-size:0.9rem;">&#127860;</div>
      <span style="font-weight:700; font-size:0.95rem; color:var(--white);">Supermercado <span style="color:var(--purple-300);">El Tenedor</span></span>
      <span onclick="document.dispatchEvent(new KeyboardEvent('keydown',{key:'F1',bubbles:true}))" style="font-size:0.72rem; color:var(--gray-3); cursor:pointer; border:1px solid var(--gray-1); border-radius:4px; padding:0.1rem 0.4rem;" title="Ver atajos de teclado">F1 Ayuda</span>
    </div>
    <div style="display:flex; align-items:center; gap:0.75rem;">
      <span id="items-count" class="stat-chip">0 productos</span>
      <button class="btn btn-success" id="btn-pay" onclick="showPaymentModal()" style="padding:0.4rem 1rem; font-size:0.82rem; display:none;">Pagar</button>
    </div>
  </div>

  {# Tabs de ventas #}
  <div id="tabs-bar" style="flex-shrink:0; display:flex; align-items:center; border-bottom:1px solid var(--border); background:var(--dark-3); padding:0 0.75rem; overflow-x:auto; min-height:42px;">
    <div id="tabs-list" style="display:flex; align-items:flex-end; gap:2px; flex:1;"></div>
  </div>

  {# Barra de busqueda #}
  <div style="flex-shrink:0; padding:0.75rem 1.25rem; border-bottom:1px solid var(--border); background:var(--dark-2);">
    <div id="sale-error" class="alert alert-error" style="display:none; margin-bottom:0.6rem; padding:0.5rem 0.85rem; font-size:0.82rem;"></div>
    <div style="display:flex; gap:0.6rem; align-items:center;">
      <div style="flex:1; position:relative;">
        <input type="text" id="product-search"
          placeholder="Busca un producto por codigo o nombre..."
          autocomplete="off"
          oninput="onSearchInput()"
          onkeydown="onSearchKeydown(event)"
          style="width:100%; padding:0.6rem 1rem; background:var(--dark-3); border:1px solid var(--gray-1); border-radius:var(--radius-sm); font-size:0.92rem; font-family:inherit; color:var(--white); outline:none; transition:border-color 0.2s, box-shadow 0.2s;"
          onfocus="this.style.borderColor='var(--purple-500)'; this.style.boxShadow='0 0 0 3px rgba(124,58,237,0.18)'"
          onblur="this.style.borderColor='var(--gray-1)'; this.style.boxShadow='none'">
        <div id="search-dropdown" style="display:none; position:absolute; top:100%; left:0; right:0; z-index:200; background:var(--dark-3); border:1px solid var(--purple-500); border-radius:var(--radius-sm); box-shadow:var(--shadow); max-height:240px; overflow-y:auto; margin-top:2px;"></div>
      </div>
      <button class="btn btn-primary" onclick="startSale()" style="padding:0.6rem 1.2rem; font-size:0.88rem; white-space:nowrap; font-weight:700;">
        + Nueva Venta
      </button>

    </div>
  </div>

  {# Tabla de items #}
  <div style="flex:1; overflow-y:auto;">
    <table style="margin:0; border-radius:0; border:none; box-shadow:none;">
      <thead style="position:sticky; top:0; z-index:1; background:var(--dark-3);">
        <tr>
          <th style="width:40%; padding:0.7rem 1.25rem;">Producto</th>
          <th style="width:15%; padding:0.7rem 1rem;">Precio</th>
          <th style="width:18%; padding:0.7rem 1rem;">Cantidad</th>
          <th style="width:17%; padding:0.7rem 1rem;">Subtotal</th>
          <th style="width:10%; text-align:center; padding:0.7rem 1rem;">Accion</th>
        </tr>
      </thead>
      <tbody id="items-body">
        <tr>
          <td colspan="5" class="empty-state" style="padding:4rem 1rem;">
            <div style="font-size:2.5rem; margin-bottom:0.6rem;">&#128722;</div>
            <div>Haz clic en <strong>+ Nueva Venta</strong> para comenzar</div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  {# Footer totales #}
  <div style="flex-shrink:0; border-top:1px solid var(--border); background:var(--dark-3); padding:0.85rem 1.25rem; display:flex; align-items:center; justify-content:space-between; gap:1rem;">
    <div style="display:flex; gap:2rem; align-items:center;">
      <div>
        <div style="font-size:0.72rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:0.15rem;">Productos</div>
        <div id="footer-count" style="font-weight:700; color:var(--white); font-size:1rem;">0</div>
      </div>
      <div>
        <div style="font-size:0.72rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:0.15rem;">Subtotal</div>
        <div style="font-weight:700; color:var(--white); font-size:1rem;">$<span id="sale-subtotal">0.00</span></div>
      </div>
      <div>
        <div style="font-size:0.72rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:0.15rem;">TOTAL</div>
        <div style="font-weight:900; color:var(--purple-300); font-size:1.6rem; letter-spacing:-1px; line-height:1;">$<span id="sale-total">0.00</span></div>
      </div>
    </div>
    <button class="btn btn-success" id="btn-pay-footer" onclick="showPaymentModal()" style="padding:0.7rem 2rem; font-size:1rem; display:none;">
      Ir a Pagar
    </button>
  </div>

</div>

{# Panel de atajos de teclado (F1) #}
<div id="shortcuts-tip" style="display:none; position:fixed; bottom:1.2rem; right:1.2rem; z-index:999; background:var(--dark-3); border:1px solid var(--purple-500); border-radius:var(--radius); padding:1rem 1.25rem; box-shadow:var(--shadow); min-width:260px;">
  <div style="font-weight:700; color:var(--purple-300); margin-bottom:0.75rem; font-size:0.88rem; display:flex; justify-content:space-between; align-items:center;">
    <span>&#9000; Atajos de teclado</span>
    <span style="font-size:0.72rem; color:var(--gray-3);">F1 para cerrar</span>
  </div>
  <table style="border:none; box-shadow:none; margin:0; width:100%; background:transparent;">
    <tbody>
      <tr style="border:none;"><td style="padding:0.2rem 0.5rem 0.2rem 0; border:none;"><kbd style="background:var(--dark-2);border:1px solid var(--gray-1);border-radius:4px;padding:0.1rem 0.4rem;font-size:0.78rem;color:var(--white);">F2</kbd></td><td style="padding:0.2rem 0; border:none; font-size:0.82rem; color:var(--text-muted);">Nueva Venta</td></tr>
      <tr style="border:none;"><td style="padding:0.2rem 0.5rem 0.2rem 0; border:none;"><kbd style="background:var(--dark-2);border:1px solid var(--gray-1);border-radius:4px;padding:0.1rem 0.4rem;font-size:0.78rem;color:var(--white);">F4</kbd></td><td style="padding:0.2rem 0; border:none; font-size:0.82rem; color:var(--text-muted);">Ir a Pagar / Confirmar</td></tr>
      <tr style="border:none;"><td style="padding:0.2rem 0.5rem 0.2rem 0; border:none;"><kbd style="background:var(--dark-2);border:1px solid var(--gray-1);border-radius:4px;padding:0.1rem 0.4rem;font-size:0.78rem;color:var(--white);">F5</kbd></td><td style="padding:0.2rem 0; border:none; font-size:0.82rem; color:var(--text-muted);">Cerrar venta activa</td></tr>
      <tr style="border:none;"><td style="padding:0.2rem 0.5rem 0.2rem 0; border:none;"><kbd style="background:var(--dark-2);border:1px solid var(--gray-1);border-radius:4px;padding:0.1rem 0.4rem;font-size:0.78rem;color:var(--white);">Ctrl+Tab</kbd></td><td style="padding:0.2rem 0; border:none; font-size:0.82rem; color:var(--text-muted);">Siguiente venta</td></tr>
      <tr style="border:none;"><td style="padding:0.2rem 0.5rem 0.2rem 0; border:none;"><kbd style="background:var(--dark-2);border:1px solid var(--gray-1);border-radius:4px;padding:0.1rem 0.4rem;font-size:0.78rem;color:var(--white);">Ctrl+&#8679;+Tab</kbd></td><td style="padding:0.2rem 0; border:none; font-size:0.82rem; color:var(--text-muted);">Venta anterior</td></tr>
      <tr style="border:none;"><td style="padding:0.2rem 0.5rem 0.2rem 0; border:none;"><kbd style="background:var(--dark-2);border:1px solid var(--gray-1);border-radius:4px;padding:0.1rem 0.4rem;font-size:0.78rem;color:var(--white);">Esc</kbd></td><td style="padding:0.2rem 0; border:none; font-size:0.82rem; color:var(--text-muted);">Cerrar modal</td></tr>
      <tr style="border:none;"><td style="padding:0.2rem 0.5rem 0.2rem 0; border:none;"><kbd style="background:var(--dark-2);border:1px solid var(--gray-1);border-radius:4px;padding:0.1rem 0.4rem;font-size:0.78rem;color:var(--white);">Enter</kbd></td><td style="padding:0.2rem 0; border:none; font-size:0.82rem; color:var(--text-muted);">Confirmar pago</td></tr>
      <tr style="border:none;"><td style="padding:0.2rem 0.5rem 0.2rem 0; border:none;"><kbd style="background:var(--dark-2);border:1px solid var(--gray-1);border-radius:4px;padding:0.1rem 0.4rem;font-size:0.78rem;color:var(--white);">F1</kbd></td><td style="padding:0.2rem 0; border:none; font-size:0.82rem; color:var(--text-muted);">Mostrar/ocultar esta ayuda</td></tr>
    </tbody>
  </table>
</div>

{# Modal Escaner de Codigo de Barras #}
<div class="modal-overlay" id="scanner-modal">
  <div class="modal" style="max-width:480px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
      <h2 style="margin:0; font-size:1.1rem; color:var(--white); display:flex; align-items:center; gap:0.5rem;">
        &#128247; Escanear Codigo de Barras
      </h2>
      <button onclick="closeScanner()" style="background:none;border:none;color:var(--gray-3);cursor:pointer;font-size:1.2rem;padding:0.2rem;">X</button>
    </div>
    <div id="scanner-error" class="alert alert-error" style="display:none; margin-bottom:0.75rem;"></div>
    <div id="scanner-status" style="font-size:0.82rem; color:var(--text-muted); margin-bottom:0.75rem; text-align:center;">
      Apunta la camara al codigo de barras del producto
    </div>
    {# Viewport de la camara #}
    <div id="scanner-viewport" style="position:relative; width:100%; background:#000; border-radius:var(--radius-sm); overflow:hidden; min-height:260px; display:flex; align-items:center; justify-content:center;">
      <video id="scanner-video" style="width:100%; display:block;" autoplay playsinline muted></video>
      <canvas id="scanner-canvas" style="display:none;"></canvas>
      {# Linea de escaneo animada #}
      <div id="scan-line" style="display:none; position:absolute; left:10%; right:10%; height:2px; background:var(--purple-400); box-shadow:0 0 8px var(--purple-400); animation:scanline 1.5s ease-in-out infinite;"></div>
      {# Overlay de esquinas #}
      <div style="position:absolute; inset:0; pointer-events:none;">
        <div style="position:absolute; top:15%; left:15%; width:40px; height:40px; border-top:3px solid var(--purple-400); border-left:3px solid var(--purple-400); border-radius:3px 0 0 0;"></div>
        <div style="position:absolute; top:15%; right:15%; width:40px; height:40px; border-top:3px solid var(--purple-400); border-right:3px solid var(--purple-400); border-radius:0 3px 0 0;"></div>
        <div style="position:absolute; bottom:15%; left:15%; width:40px; height:40px; border-bottom:3px solid var(--purple-400); border-left:3px solid var(--purple-400); border-radius:0 0 0 3px;"></div>
        <div style="position:absolute; bottom:15%; right:15%; width:40px; height:40px; border-bottom:3px solid var(--purple-400); border-right:3px solid var(--purple-400); border-radius:0 0 3px 0;"></div>
      </div>
    </div>
    {# Resultado detectado #}
    <div id="scan-result" style="display:none; margin-top:0.75rem; background:var(--dark-3); border-radius:var(--radius-sm); padding:0.75rem 1rem; display:flex; align-items:center; gap:0.75rem;">
      <span style="font-size:1.2rem;">&#9989;</span>
      <div>
        <div style="font-size:0.72rem; color:var(--text-muted);">Codigo detectado</div>
        <div id="scan-result-code" style="font-weight:700; color:var(--white); font-size:0.95rem;"></div>
      </div>
    </div>
    {# Input manual como fallback #}
    <div style="margin-top:0.75rem;">
      <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.35rem;">O ingresa el codigo manualmente:</div>
      <div style="display:flex; gap:0.5rem;">
        <input type="text" id="manual-barcode" placeholder="Ej: 7702001234567"
          style="flex:1; padding:0.5rem 0.75rem; background:var(--dark-3); border:1px solid var(--gray-1); border-radius:var(--radius-sm); color:var(--white); font-family:inherit; font-size:0.88rem; outline:none;"
          onkeydown="if(event.key==='Enter') addByBarcode(this.value)">
        <button class="btn btn-primary" onclick="addByBarcode(document.getElementById('manual-barcode').value)" style="padding:0.5rem 1rem; font-size:0.85rem;">
          Agregar
        </button>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes scanline {
  0%   { top: 20%; }
  50%  { top: 75%; }
  100% { top: 20%; }
}
</style>

{# Modal de Pago #}
<div class="modal-overlay" id="payment-modal">
  <div class="modal" style="max-width:420px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
      <h2 style="margin:0; font-size:1.1rem; color:var(--white);">Confirmar Pago</h2>
      <button onclick="closePaymentModal()" style="background:none;border:none;color:var(--gray-3);cursor:pointer;font-size:1.2rem;padding:0.2rem;">X</button>
    </div>
    <div id="payment-error" class="alert alert-error" style="display:none; margin-bottom:0.75rem;"></div>
    <div style="background:var(--dark-3); border-radius:var(--radius-sm); padding:0.85rem 1rem; margin-bottom:1rem; display:flex; justify-content:space-between; align-items:center;">
      <span style="color:var(--text-muted); font-size:0.9rem;">Total a pagar</span>
      <span style="font-size:1.5rem; font-weight:900; color:var(--purple-300);">$<span id="modal-total">0.00</span></span>
    </div>
    <div class="form-group">
      <label for="payment-method">Metodo de pago</label>
      <select id="payment-method">
        <option value="CASH">Efectivo</option>
        <option value="CREDIT_CARD">Tarjeta de Credito</option>
        <option value="DEBIT_CARD">Tarjeta de Debito</option>
      </select>
    </div>
    <div class="form-group">
      <label for="payment-amount">Monto recibido ($)</label>
      <input type="number" id="payment-amount" min="0" step="0.01" placeholder="0.00" oninput="calcChange()">
    </div>
    <div id="change-display" style="display:none; margin-bottom:1rem;">
      <div class="change-box" style="width:100%; text-align:center; font-size:1.1rem; padding:0.75rem;">
        Cambio: $<span id="change-amount">0.00</span>
      </div>
    </div>
    <div style="display:flex; gap:0.6rem; margin-top:0.5rem;">
      <button class="btn btn-success" onclick="processPay()" style="flex:1; justify-content:center; padding:0.7rem; font-size:0.95rem;">Confirmar Pago</button>
      <button class="btn btn-secondary" onclick="closePaymentModal()" style="padding:0.7rem 1rem;">Cancelar</button>
    </div>
  </div>
</div>

<script>
(function() {
  var sales      = {};      // { [id]: { id, label, items[] } }
  var saleOrder  = [];      // orden de creacion
  var activeId   = null;
  var tabCounter = 0;

  var selectedProductId = null;
  var highlightedIndex  = -1;
  var searchTimeout     = null;

  window.addEventListener('load', function() {
    renderTabs();
    document.getElementById('product-search').focus();
  });

  /* ── helpers ─────────────────────────────────────────────────────────── */

  function showError(msg) {
    var el = document.getElementById('sale-error');
    el.textContent = msg;
    el.style.display = 'flex';
    setTimeout(function() { el.style.display = 'none'; }, 4000);
  }

  function parseInput(raw) {
    var m = raw.match(/^(\d+)\*(.*)$/);
    if (m) return { quantity: parseInt(m[1], 10) || 1, query: m[2].trim() };
    return { quantity: 1, query: raw.trim() };
  }

  function activeSale() { return activeId ? sales[activeId] : null; }

  function calcSaleTotal(items) {
    if (!items || !items.length) return 0;
    return items.reduce(function(s, it) { return s + parseFloat(it.subtotal || 0); }, 0);
  }

  /* ── tabs ────────────────────────────────────────────────────────────── */

  function renderTabs() {
    var list = document.getElementById('tabs-list');
    if (!saleOrder.length) { list.innerHTML = ''; updateHeader(); return; }

    var html = '';
    for (var i = 0; i < saleOrder.length; i++) {
      var id      = saleOrder[i];
      var s       = sales[id];
      var active  = id === activeId;
      var n       = s.items ? s.items.length : 0;
      var total   = calcSaleTotal(s.items);
      var border  = active ? 'var(--purple-500)' : 'var(--border)';
      var bg      = active ? 'var(--dark-2)'     : 'var(--dark-3)';
      var color   = active ? 'var(--purple-300)' : 'var(--gray-3)';
      var weight  = active ? '700' : '500';

      html += '<div onclick="switchTab(\'' + id + '\')" style="'
        + 'display:flex;align-items:center;gap:0.4rem;padding:0.4rem 0.75rem 0.5rem;'
        + 'cursor:pointer;border-radius:6px 6px 0 0;'
        + 'border:1px solid ' + border + ';border-bottom:' + (active ? '1px solid var(--dark-2)' : '1px solid var(--border)') + ';'
        + 'background:' + bg + ';margin-bottom:-1px;min-width:110px;max-width:180px;">'
        + '<span style="font-size:0.78rem;font-weight:' + weight + ';color:' + color + ';flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">'
        + s.label + (n > 0 ? ' (' + n + ')' : '')
        + '</span>'
        + (n > 0 ? '<span style="font-size:0.7rem;color:var(--purple-300);font-weight:600;white-space:nowrap;">$' + total.toFixed(2) + '</span>' : '')
        + '<button onclick="event.stopPropagation();closeTab(\'' + id + '\')" '
        + 'style="background:none;border:none;color:var(--gray-3);cursor:pointer;font-size:0.75rem;padding:0 0.1rem;margin-left:0.2rem;" title="Cerrar">&#10005;</button>'
        + '</div>';
    }
    list.innerHTML = html;
    updateHeader();
  }

  window.switchTab = function(id) {
    if (!sales[id]) return;
    activeId = id;
    renderTabs();
    renderItems();
    document.getElementById('product-search').focus();
  };

  window.closeTab = function(id) {
    var idx = saleOrder.indexOf(id);
    saleOrder.splice(idx, 1);
    delete sales[id];
    if (activeId === id) {
      activeId = saleOrder.length ? saleOrder[Math.max(0, idx - 1)] : null;
    }
    renderTabs();
    renderItems();
    document.getElementById('product-search').focus();
  };

  /* ── nueva venta ─────────────────────────────────────────────────────── */

  window.startSale = async function() {
    try {
      var res  = await fetch('/sale/start', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      var data = await res.json();
      if (!res.ok) { showError(data.error || 'Error al iniciar.'); return; }
      tabCounter++;
      var id = data.id;
      sales[id]  = { id: id, label: 'Venta ' + tabCounter, items: data.items || [] };
      saleOrder.push(id);
      activeId = id;
      renderTabs();
      renderItems();
      document.getElementById('product-search').focus();
    } catch(e) { showError('Error al iniciar. Verifica el backend.'); }
  };

  /* ── busqueda ────────────────────────────────────────────────────────── */

  window.onSearchInput = function() {
    var raw    = document.getElementById('product-search').value;
    var parsed = parseInput(raw);
    selectedProductId = null;
    clearTimeout(searchTimeout);
    if (!parsed.query) { closeDropdown(); return; }
    searchTimeout = setTimeout(function() { fetchSuggestions(parsed.query); }, 180);
  };

  async function fetchSuggestions(query) {
    try {
      var res = await fetch('/sale/search-products?q=' + encodeURIComponent(query));
      if (!res.ok) { closeDropdown(); return; }
      renderDropdown(await res.json());
    } catch(e) { closeDropdown(); }
  }

  function renderDropdown(products) {
    var dd = document.getElementById('search-dropdown');
    highlightedIndex = -1;
    if (!products || !products.length) { closeDropdown(); return; }
    var html = '';
    for (var i = 0; i < products.length; i++) {
      var p       = products[i];
      var noStock = p.outOfStock || p.stockLevel === 0;
      var price   = parseFloat(p.price).toFixed(2);
      var stock   = noStock ? 'Sin stock' : (p.stockLevel + ' uds.');
      var scolor  = noStock ? 'var(--danger)' : 'var(--text-muted)';
      html += '<div class="dd-item"'
        + ' data-id="'   + p.id + '"'
        + ' data-name="' + p.name.replace(/"/g, '&quot;') + '"'
        + ' data-idx="'  + i + '"'
        + ' onmouseenter="window.ddHighlight(' + i + ')"'
        + ' onclick="window.ddSelect(this)"'
        + ' style="display:flex;justify-content:space-between;align-items:center;'
        + 'padding:0.55rem 1rem;cursor:pointer;opacity:' + (noStock ? '0.45' : '1') + ';'
        + 'border-bottom:1px solid rgba(255,255,255,0.04);">'
        + '<div>'
        + '<span style="font-weight:500;color:var(--white);font-size:0.88rem;">' + p.name + '</span>'
        + '<span style="font-size:0.75rem;color:var(--gray-3);margin-left:0.4rem;">(' + p.code + ')</span>'
        + '</div>'
        + '<div style="display:flex;gap:0.5rem;align-items:center;">'
        + '<span style="color:var(--purple-300);font-weight:600;font-size:0.88rem;">$' + price + '</span>'
        + '<span style="font-size:0.7rem;color:' + scolor + ';">' + stock + '</span>'
        + '</div>'
        + '</div>';
    }
    dd.innerHTML = html;
    dd.style.display = 'block';
  }

  window.ddHighlight = function(idx) {
    highlightedIndex = idx;
    document.querySelectorAll('.dd-item').forEach(function(el, i) {
      el.style.background = i === idx ? 'rgba(124,58,237,0.2)' : '';
    });
  };

  /* Al hacer clic en un producto del dropdown → agrega directo a la lista */
  window.ddSelect = function(el) {
    var id   = el.getAttribute('data-id');
    var name = el.getAttribute('data-name');
    if (!id) return;
    selectedProductId = id;
    var raw = document.getElementById('product-search').value;
    var m   = raw.match(/^(\d+)\*/);
    document.getElementById('product-search').value = m ? m[0] + name : name;
    closeDropdown();
    addProduct();   // ← agrega automaticamente
  };

  function closeDropdown() {
    var dd = document.getElementById('search-dropdown');
    if (dd) dd.style.display = 'none';
    highlightedIndex = -1;
  }

  window.onSearchKeydown = function(e) {
    var items = document.querySelectorAll('.dd-item');
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      highlightedIndex = Math.min(highlightedIndex + 1, items.length - 1);
      window.ddHighlight(highlightedIndex);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      highlightedIndex = Math.max(highlightedIndex - 1, 0);
      window.ddHighlight(highlightedIndex);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (highlightedIndex >= 0 && items[highlightedIndex]) {
        window.ddSelect(items[highlightedIndex]);  // ddSelect ya llama addProduct
      } else {
        addProduct();
      }
    } else if (e.key === 'Escape') {
      closeDropdown();
    }
  };

  document.addEventListener('click', function(e) {
    var input = document.getElementById('product-search');
    var dd    = document.getElementById('search-dropdown');
    if (input && dd && !input.contains(e.target) && !dd.contains(e.target)) closeDropdown();
  });

  /* ── agregar producto ────────────────────────────────────────────────── */

  async function addProduct() {
    if (!activeId) { showError('Primero crea una venta con "+ Nueva Venta".'); return; }
    var raw = document.getElementById('product-search').value.trim();
    if (!raw) return;

    var parsed     = parseInput(raw);
    var productRef = selectedProductId || parsed.query;
    var qty        = parsed.quantity;

    // limpiar input de inmediato
    document.getElementById('product-search').value = '';
    selectedProductId = null;
    closeDropdown();
    document.getElementById('product-search').focus();

    try {
      var res  = await fetch('/sale/' + activeId + '/item', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ product_id: productRef, quantity: qty })
      });
      var data = await res.json();
      if (!res.ok) { showError(data.error || 'Producto no encontrado.'); return; }
      sales[activeId].items = data.items || [];
      renderTabs();
      renderItems();
    } catch(e) { showError('Error de conexion.'); }
  }

  /* ── render ──────────────────────────────────────────────────────────── */

  function updateHeader() {
    var s = activeSale();
    var n = s && s.items ? s.items.length : 0;
    document.getElementById('items-count').textContent = n + ' producto' + (n !== 1 ? 's' : '');
    var show = s && n > 0 ? 'inline-flex' : 'none';
    document.getElementById('btn-pay').style.display        = show;
    document.getElementById('btn-pay-footer').style.display = show;
  }

  function renderItems() {
    var s     = activeSale();
    var items = s ? (s.items || []) : [];
    var tbody = document.getElementById('items-body');
    var n     = items.length;

    document.getElementById('footer-count').textContent = n;
    updateHeader();

    if (!n) {
      var msg = s
        ? 'Busca un producto para agregarlo a esta venta'
        : 'Haz clic en <strong>+ Nueva Venta</strong> para comenzar';
      tbody.innerHTML = '<tr><td colspan="5" class="empty-state" style="padding:4rem 1rem;">'
        + '<div style="font-size:2.5rem;margin-bottom:0.6rem;">&#128722;</div>'
        + '<div>' + msg + '</div></td></tr>';
      document.getElementById('sale-total').textContent    = '0.00';
      document.getElementById('sale-subtotal').textContent = '0.00';
      return;
    }

    var rows = '';
    for (var i = 0; i < items.length; i++) {
      var item  = items[i];
      var price = parseFloat(item.unitPrice || item.price || 0);
      var sub   = parseFloat(item.subtotal  || (price * parseInt(item.quantity || 1)));
      rows += '<tr>'
        + '<td style="font-weight:500;font-size:0.88rem;">' + (item.productName || item.productId) + '</td>'
        + '<td style="color:var(--purple-300);font-weight:600;font-size:0.88rem;">$' + price.toFixed(2) + '</td>'
        + '<td><input type="number" min="1" value="' + item.quantity + '"'
        + ' style="width:64px;padding:0.28rem 0.4rem;background:var(--dark-3);border:1px solid var(--gray-1);border-radius:5px;color:var(--white);font-family:inherit;font-size:0.85rem;"'
        + ' onchange="window.updateQty(' + i + ',this.value)"></td>'
        + '<td id="sub-' + i + '" style="font-weight:600;font-size:0.88rem;">$' + sub.toFixed(2) + '</td>'
        + '<td style="text-align:center;"><button class="btn btn-danger" style="padding:0.25rem 0.55rem;font-size:0.75rem;" onclick="window.removeItem(' + i + ')">X</button></td>'
        + '</tr>';
    }
    tbody.innerHTML = rows;
    recalcTotal();
  }

  window.updateQty = function(idx, val) {
    var s = activeSale();
    if (!s) return;
    var qty   = parseInt(val) || 1;
    var price = parseFloat(s.items[idx].unitPrice || s.items[idx].price || 0);
    s.items[idx].quantity = qty;
    s.items[idx].subtotal = price * qty;
    document.getElementById('sub-' + idx).textContent = '$' + s.items[idx].subtotal.toFixed(2);
    recalcTotal();
    renderTabs();
  };

  window.removeItem = function(idx) {
    var s = activeSale();
    if (!s) return;
    s.items.splice(idx, 1);
    renderTabs();
    renderItems();
  };

  function recalcTotal() {
    var s     = activeSale();
    var total = s ? calcSaleTotal(s.items) : 0;
    document.getElementById('sale-total').textContent    = total.toFixed(2);
    document.getElementById('sale-subtotal').textContent = total.toFixed(2);
  }

  /* ── pago ────────────────────────────────────────────────────────────── */

  window.showPaymentModal = function() {
    var s = activeSale();
    if (!s || !s.items || !s.items.length) { showError('Agrega productos antes de pagar.'); return; }
    document.getElementById('modal-total').textContent      = document.getElementById('sale-total').textContent;
    document.getElementById('payment-amount').value         = '';
    document.getElementById('change-display').style.display = 'none';
    document.getElementById('payment-error').style.display  = 'none';
    document.getElementById('payment-modal').classList.add('open');
    setTimeout(function() { document.getElementById('payment-amount').focus(); }, 100);
  };

  window.closePaymentModal = function() {
    document.getElementById('payment-modal').classList.remove('open');
    document.getElementById('product-search').focus();
  };

  window.calcChange = function() {
    var total  = parseFloat(document.getElementById('modal-total').textContent) || 0;
    var amount = parseFloat(document.getElementById('payment-amount').value)    || 0;
    var box    = document.getElementById('change-display');
    box.style.display = amount > 0 ? 'block' : 'none';
    if (amount > 0) document.getElementById('change-amount').textContent = Math.max(0, amount - total).toFixed(2);
  };

  window.processPay = async function() {
    var method = document.getElementById('payment-method').value;
    var amount = parseFloat(document.getElementById('payment-amount').value);
    var total  = parseFloat(document.getElementById('modal-total').textContent);
    var errEl  = document.getElementById('payment-error');
    errEl.style.display = 'none';
    if (!amount || amount <= 0) { errEl.textContent = 'Ingresa un monto valido.'; errEl.style.display = 'flex'; return; }
    if (amount < total)         { errEl.textContent = 'Monto insuficiente. Total: $' + total.toFixed(2); errEl.style.display = 'flex'; return; }
    try {
      var res  = await fetch('/sale/' + activeId + '/pay', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ method: method, amount: amount })
      });
      var data = await res.json();
      if (!res.ok) { errEl.textContent = data.error || 'Error al procesar.'; errEl.style.display = 'flex'; return; }
      var change = data.change !== undefined ? data.change : (amount - total);
      window.closePaymentModal();
      alert('Pago exitoso! Cambio: $' + parseFloat(change).toFixed(2));
      window.closeTab(activeId);   // cierra el tab de la venta pagada
    } catch(e) { errEl.textContent = 'Error al procesar.'; errEl.style.display = 'flex'; }
  };

  document.getElementById('payment-modal').addEventListener('click', function(e) {
    if (e.target === this) window.closePaymentModal();
  });

  /* ── escaner de codigo de barras ─────────────────────────────────────── */
  var scannerStream = null;
  var scannerInterval = null;
  var lastScannedCode = null;
  var scannerOpen = false;

  window.openScanner = function() {
    if (!activeId) { showError('Primero crea una venta con "+ Nueva Venta".'); return; }
    document.getElementById('scanner-modal').classList.add('open');
    document.getElementById('scan-result').style.display = 'none';
    document.getElementById('scanner-error').style.display = 'none';
    document.getElementById('manual-barcode').value = '';
    document.getElementById('scanner-status').textContent = 'Iniciando camara...';
    scannerOpen = true;
    lastScannedCode = null;
    startCamera();
  };

  window.closeScanner = function() {
    scannerOpen = false;
    stopCamera();
    document.getElementById('scanner-modal').classList.remove('open');
    document.getElementById('scan-line').style.display = 'none';
    document.getElementById('product-search').focus();
  };

  function startCamera() {
    var video = document.getElementById('scanner-video');
    var errEl = document.getElementById('scanner-error');
    errEl.style.display = 'none';

    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      errEl.textContent = 'Tu navegador no soporta acceso a la camara. Usa el campo manual.';
      errEl.style.display = 'flex';
      document.getElementById('scanner-status').textContent = 'Camara no disponible';
      return;
    }

    navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } }
    }).then(function(stream) {
      scannerStream = stream;
      video.srcObject = stream;
      video.play();
      document.getElementById('scan-line').style.display = 'block';
      document.getElementById('scanner-status').textContent = 'Apunta al codigo de barras del producto';
      startDecoding();
    }).catch(function(err) {
      errEl.textContent = 'No se pudo acceder a la camara: ' + err.message + '. Usa el campo manual.';
      errEl.style.display = 'flex';
      document.getElementById('scanner-status').textContent = 'Camara no disponible';
    });
  }

  function stopCamera() {
    if (scannerInterval) { clearInterval(scannerInterval); scannerInterval = null; }
    if (scannerStream) {
      scannerStream.getTracks().forEach(function(t) { t.stop(); });
      scannerStream = null;
    }
    var video = document.getElementById('scanner-video');
    video.srcObject = null;
  }

  function startDecoding() {
    // Usamos BarcodeDetector API nativa si está disponible (Chrome/Edge modernos)
    if ('BarcodeDetector' in window) {
      var detector = new BarcodeDetector({
        formats: ['ean_13','ean_8','code_128','code_39','upc_a','upc_e','qr_code','data_matrix']
      });
      var video = document.getElementById('scanner-video');
      scannerInterval = setInterval(async function() {
        if (!scannerOpen || video.readyState < 2) return;
        try {
          var barcodes = await detector.detect(video);
          if (barcodes && barcodes.length > 0) {
            var code = barcodes[0].rawValue;
            if (code && code !== lastScannedCode) {
              lastScannedCode = code;
              onBarcodeDetected(code);
            }
          }
        } catch(e) {}
      }, 300);
    } else {
      // Fallback: ZXing via CDN
      loadZxing();
    }
  }

  function loadZxing() {
    if (document.getElementById('zxing-script')) { initZxing(); return; }
    var s = document.createElement('script');
    s.id = 'zxing-script';
    s.src = 'https://unpkg.com/@zxing/library@0.19.1/umd/index.min.js';
    s.onload = initZxing;
    s.onerror = function() {
      document.getElementById('scanner-status').textContent = 'Libreria no disponible. Usa el campo manual.';
    };
    document.head.appendChild(s);
  }

  function initZxing() {
    var video = document.getElementById('scanner-video');
    try {
      var codeReader = new ZXing.BrowserMultiFormatReader();
      codeReader.decodeFromVideoElement(video, function(result, err) {
        if (result && result.text && result.text !== lastScannedCode) {
          lastScannedCode = result.text;
          onBarcodeDetected(result.text);
        }
      });
      // Guardar referencia para poder detenerlo
      window._zxingReader = codeReader;
    } catch(e) {
      document.getElementById('scanner-status').textContent = 'Error al iniciar decodificador. Usa el campo manual.';
    }
  }

  function onBarcodeDetected(code) {
    // Feedback visual
    document.getElementById('scan-result').style.display = 'flex';
    document.getElementById('scan-result-code').textContent = code;
    document.getElementById('scanner-status').textContent = 'Codigo detectado! Buscando producto...';

    // Vibrar si el dispositivo lo soporta
    if (navigator.vibrate) navigator.vibrate(100);

    // Agregar producto por codigo
    addByBarcode(code);
  }

  window.addByBarcode = async function(code) {
    code = (code || '').trim();
    if (!code) return;
    if (!activeId) { showError('Primero crea una venta.'); closeScanner(); return; }

    document.getElementById('scanner-status').textContent = 'Buscando: ' + code + '...';

    try {
      var res  = await fetch('/sale/' + activeId + '/item', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ product_id: code, quantity: 1 })
      });
      var data = await res.json();
      if (!res.ok) {
        document.getElementById('scanner-status').textContent = 'Producto no encontrado: ' + code;
        document.getElementById('scanner-error').textContent = data.error || 'Producto no encontrado para el codigo: ' + code;
        document.getElementById('scanner-error').style.display = 'flex';
        lastScannedCode = null; // permitir reintentar
        return;
      }
      sales[activeId].items = data.items || [];
      renderTabs();
      renderItems();
      document.getElementById('scanner-status').textContent = 'Producto agregado! Escanea otro...';
      document.getElementById('scanner-error').style.display = 'none';
      document.getElementById('manual-barcode').value = '';
      // Resetear para permitir escanear el mismo codigo de nuevo
      setTimeout(function() { lastScannedCode = null; }, 1500);
    } catch(e) {
      document.getElementById('scanner-error').textContent = 'Error de conexion.';
      document.getElementById('scanner-error').style.display = 'flex';
    }
  };

  document.getElementById('scanner-modal').addEventListener('click', function(e) {
    if (e.target === this) closeScanner();
  });

  /* ── atajos de teclado POS ───────────────────────────────────────────── */
  document.addEventListener('keydown', function(e) {
    var modal = document.getElementById('payment-modal');
    var modalOpen = modal.classList.contains('open');

    // F2 → Nueva Venta
    if (e.key === 'F2') {
      e.preventDefault();
      window.startSale();
      return;
    }

    // F3 → Abrir escaner
    if (e.key === 'F3') {
      e.preventDefault();
      window.openScanner();
      return;
    }

    // F4 → Ir a Pagar
    if (e.key === 'F4') {
      e.preventDefault();
      if (modalOpen) {
        window.processPay();
      } else {
        window.showPaymentModal();
      }
      return;
    }

    // F5 → Cerrar venta activa
    if (e.key === 'F5') {
      e.preventDefault();
      if (modalOpen) {
        window.closePaymentModal();
      } else if (activeId) {
        if (confirm('Cerrar la venta activa?')) window.closeTab(activeId);
      }
      return;
    }

    // Ctrl+Tab → siguiente venta / Ctrl+Shift+Tab → anterior venta
    if (e.ctrlKey && e.key === 'Tab') {
      e.preventDefault();
      if (saleOrder.length < 2) return;
      var idx = saleOrder.indexOf(activeId);
      var next = e.shiftKey
        ? (idx - 1 + saleOrder.length) % saleOrder.length
        : (idx + 1) % saleOrder.length;
      window.switchTab(saleOrder[next]);
      return;
    }

    // Escape → cerrar modal si está abierto
    if (e.key === 'Escape' && modalOpen) {
      e.preventDefault();
      window.closePaymentModal();
      return;
    }

    // Enter dentro del modal → confirmar pago
    if (e.key === 'Enter' && modalOpen) {
      var active = document.activeElement;
      // solo si no está en el select o en un botón
      if (active && active.tagName !== 'BUTTON' && active.tagName !== 'SELECT') {
        e.preventDefault();
        window.processPay();
      }
      return;
    }
  });

  /* ── tooltip de atajos (F1) ──────────────────────────────────────────── */
  var shortcutsVisible = false;
  document.addEventListener('keydown', function(e) {
    if (e.key === 'F1') {
      e.preventDefault();
      var tip = document.getElementById('shortcuts-tip');
      shortcutsVisible = !shortcutsVisible;
      tip.style.display = shortcutsVisible ? 'block' : 'none';
    }
  });
})();
</script>
{% endblock %}
